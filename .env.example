# ============================================================
# Variables de entorno de Supervisión Inteligente
# Solo para desarrollo. Cambia TODAS las claves fuera de desarrollo.
# ============================================================

# --- Base de datos (las lee docker-compose.yml desde un archivo ".env" en esta carpeta) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=supervision_geodb

# --- Backend (las lee el proceso de uvicorn; defínelas en la terminal antes de ejecutarlo) ---
# DATABASE_URL=postgresql+psycopg2://admin:supersecretpassword@localhost:5432/supervision_geodb
# TOKEN_SECRET=una-cadena-larga-y-aleatoria      # firma los tokens de sesión
# RADIO_MAXIMO_M=150                             # distancia máxima al centro de costo, en metros
